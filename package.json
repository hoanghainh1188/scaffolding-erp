{
  "name": "scaffolding-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/check-colors.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project component",
    "test:int": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:prod": "E2E=1 next build && PW_PRODUCTION=1 playwright test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import ./scripts/register-aliases.mjs src/db/migrate.mts",
    "db:roles": "node --env-file-if-exists=.env scripts/db-roles.mts",
    "db:studio": "drizzle-kit studio",
    "db:seed:dev": "node --env-file-if-exists=.env --import ./scripts/register-aliases.mjs scripts/seed-dev.mts",
    "db:seed:demo": "node --env-file-if-exists=.env --import ./scripts/register-aliases.mjs scripts/seed-demo.mts",
    "auth:create-director": "node --env-file-if-exists=.env --import ./scripts/register-aliases.mjs scripts/create-director.mts",
    "auth:unlock": "node --env-file-if-exists=.env --import ./scripts/register-aliases.mjs scripts/unlock-user.mts",
    "inventory:check": "node --env-file-if-exists=.env --import ./scripts/register-aliases.mjs scripts/inventory-check.mts",
    "tokens": "node scripts/build-tokens.mts",
    "postinstall": "node scripts/copy-zxing-wasm.mts"
  },
  "dependencies": {
    "@tanstack/react-table": "8.21.3",
    "barcode-detector": "3.2.3",
    "better-auth": "1.7.14",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "postgres": "3.4.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
