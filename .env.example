# Copy to .env and adjust. Values below match docker-compose.yml (local only).

# The app, scripts and E2E connect as the least-privilege role erp_app
# (`npm run db:roles` creates it on an existing Docker volume).
DATABASE_URL=postgres://erp_app:erp_app@localhost:5432/scaffolding_erp

# Owner role, only for `npm run db:migrate` (and `npm run db:roles`).
# Never set it on the app server: production refuses to start with it.
DATABASE_URL_MIGRATE=postgres://erp:erp@localhost:5432/scaffolding_erp

# Name of the app role that migrations grant to (default erp_app).
# DB_APP_ROLE=erp_app

# Separate database for integration tests (`npm run test:int`): code under
# test runs as erp_app, table resets as the owner. Migrate it with
#   DATABASE_URL_MIGRATE=$TEST_DATABASE_URL_MIGRATE npm run db:migrate
TEST_DATABASE_URL=postgres://erp_app:erp_app@localhost:5432/scaffolding_erp_test
TEST_DATABASE_URL_MIGRATE=postgres://erp:erp@localhost:5432/scaffolding_erp_test

# Signs session cookies. At least 32 characters; make one with:
#   openssl rand -base64 32
# The value below is for local development only. Never reuse it elsewhere.
BETTER_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef

# Encrypts CCCD numbers: <number>:<base64 of exactly 32 bytes>, comma-separated,
# the first key encrypts. Make one with: openssl rand -base64 32
# The value below is for local development only. Never reuse it elsewhere.
PII_ENCRYPTION_KEYS=1:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Public URL of the app. Defaults to http://localhost:3000 outside production;
# required in production.
# BETTER_AUTH_URL=http://localhost:3000

# Password of the 5 sample accounts made by `npm run db:seed:dev`
# (giamdoc, ketoan, kinhdoanh, thukho, xuong). Local development only.
DEV_SEED_PASSWORD=dev-pass-1234

# Sign-in attempts allowed per IP address per minute (default 20).
# Playwright's dev server raises it; leave it unset elsewhere.
# AUTH_SIGN_IN_LIMIT_PER_MINUTE=20

# Password of the accounts the E2E global setup creates. Local/CI only.
E2E_PASSWORD=e2e-pass-1234

# Host port for the Postgres container (optional).
# POSTGRES_PORT=5432
