# Copy to .env and adjust. Values below match docker-compose.yml (local only).

# Main database for `npm run dev` and `npm run db:migrate`.
DATABASE_URL=postgres://erp:erp@localhost:5432/scaffolding_erp

# Separate database for integration tests (`npm run test:int`).
TEST_DATABASE_URL=postgres://erp:erp@localhost:5432/scaffolding_erp_test

# Signs session cookies. At least 32 characters; make one with:
#   openssl rand -base64 32
# The value below is for local development only. Never reuse it elsewhere.
BETTER_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef

# Public URL of the app. Defaults to http://localhost:3000 outside production;
# required in production.
# BETTER_AUTH_URL=http://localhost:3000

# Password of the 5 sample accounts made by `npm run db:seed:dev`
# (giamdoc, ketoan, kinhdoanh, thukho, xuong). Local development only.
DEV_SEED_PASSWORD=dev-pass-1234

# Sign-in attempts allowed per IP address per minute (default 20).
# Playwright's dev server raises it; leave it unset elsewhere.
# AUTH_SIGN_IN_LIMIT_PER_MINUTE=20

# Password of the accounts the E2E global setup creates. Local/CI only.
E2E_PASSWORD=e2e-pass-1234

# Host port for the Postgres container (optional).
# POSTGRES_PORT=5432
